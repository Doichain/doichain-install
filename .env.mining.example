# Copy to .env and fill in before `docker compose -f docker-compose-mining.yml up`.
SERVER_NAME=doichain-testnet.le-space.de
P2POOL_DOICHAIN_DEFAULT_ADDR=NFgT2Gv6C9B9WaWQ51bz9FmPinYmy8wqTE
P2POOL_BITCOIN_DEFAULT_ADDR=bc1q4dz3j27u3qwclq05mwqlmec8eeqfqcma0n2xg0

# RPC passwords -- required; compose refuses to start while they are empty.
# Generate each with: openssl rand -hex 32
# They are written into doichain.conf / bitcoin.conf on the FIRST start only;
# to change them later, edit those files inside the volumes as well.
DOICHAIN_RPC_PASSWORD=
BITCOIN_RPC_PASSWORD=

# Public address of this host, so doichaind advertises a reachable address.
EXTERNAL_IP=

# Extra doichaind arguments, e.g. -addnode=<host>. Not needed for peer discovery.
DOICHAIN_EXTRA_ARGS=

# Hostname ElectrumX reports to clients (optional).
ELECTRUMX_REPORT_HOST=
